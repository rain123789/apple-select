# 复制为 .env 后按需修改，或直接在系统环境变量里设置

# 训练好的权重路径（放这里就会自动切到真实推理）
APPLE_WEIGHTS=./weights/best.pt

# 推理参数
CONF_THRESHOLD=0.20
IOU_THRESHOLD=0.45
IMG_SIZE=640

# cuda:0 或 cpu，留空自动判断
DEVICE=

# 服务
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# 标注结果图保留时间（秒）
RESULT_TTL=600
# 单个上传大小上限（MB）
MAX_UPLOAD_MB=12

# 跨域，生产环境建议改成小程序域名
CORS_ORIGINS=*
