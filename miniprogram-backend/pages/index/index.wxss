.status-bar {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  background: #fff;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  background: #c7cdc9;
}

.status-bar.ok .status-dot { background: #2e9e5b; }
.status-bar.warn .status-dot { background: #f39c12; }
.status-bar.error .status-dot { background: #e74c3c; }

.status-bar.ok { color: #2e9e5b; }
.status-bar.warn { color: #b9770e; }
.status-bar.error { color: #c0392b; }
.status-bar.unknown { color: var(--ink-3); }

.status-text { flex: 1; }

.status-retry {
  font-size: 24rpx;
  color: var(--ink-3);
  padding: 4rpx 12rpx;
}

.mock-tip {
  background: #fff8e6;
  border: 2rpx solid #ffe2a8;
  color: #8a6414;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.image-box {
  width: 100%;
  min-height: 420rpx;
  border-radius: 20rpx;
  background: #f7f9f7;
  border: 2rpx dashed var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.preview {
  width: 100%;
  display: block;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 90rpx;
  margin-bottom: 16rpx;
}

.action-row {
  display: flex;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  height: 84rpx;
  font-size: 28rpx;
}

.action-row .action-btn + .action-btn {
  margin-left: 20rpx;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
}

.stat-cell {
  width: 50%;
  box-sizing: border-box;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
}

.stat-cell:nth-child(odd) { padding-right: 16rpx; }
.stat-cell:nth-child(even) { padding-left: 16rpx; }

.stat-value {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--green);
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}

.no-result {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  background: #f7f9f7;
  border-radius: 12rpx;
  padding: 20rpx;
}

.dist-item { margin-bottom: 22rpx; }
.dist-item:last-child { margin-bottom: 0; }

.dist-head {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.dist-tag {
  width: 18rpx;
  height: 18rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}

.dist-label {
  font-size: 28rpx;
  font-weight: 500;
  flex: 1;
}

.dist-count {
  font-size: 24rpx;
  color: var(--ink-3);
}

.dist-track {
  height: 12rpx;
  background: #eef1ee;
  border-radius: 8rpx;
  overflow: hidden;
}

.dist-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.det-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f1f4f1;
}

.det-item:last-child { border-bottom: none; }

.det-tag {
  width: 10rpx;
  height: 44rpx;
  border-radius: 6rpx;
  margin-right: 18rpx;
}

.det-main { flex: 1; }

.det-line {
  display: flex;
  align-items: baseline;
}

.det-label {
  font-size: 28rpx;
  font-weight: 500;
  flex: 1;
}

.det-conf {
  font-size: 28rpx;
  color: var(--green);
  font-weight: 600;
}

.det-bbox {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.det-index {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-left: 16rpx;
}

.footer {
  text-align: center;
  margin-top: 40rpx;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.loading-box {
  width: 260rpx;
  height: 200rpx;
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--ink-2);
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e6eae7;
  border-top-color: var(--green);
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
