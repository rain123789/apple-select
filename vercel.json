{
  "installCommand": "echo 'pure static site, skip dependency install'",
  "buildCommand": "rm -rf server scripts && echo 'pure static site, skip build'",
  "outputDirectory": "frontend-only",
  "headers": [
    {
      "source": "/(.*)\\.wasm$",
      "headers": [{ "key": "Content-Type", "value": "application/wasm" }]
    },
    {
      "source": "/(.*)\\.mjs$",
      "headers": [{ "key": "Content-Type", "value": "text/javascript" }]
    },
    {
      "source": "/(.*)\\.onnx$",
      "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }]
    }
  ]
}
